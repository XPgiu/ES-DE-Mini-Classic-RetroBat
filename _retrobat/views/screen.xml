<?xml version="1.0" encoding="UTF-8"?>
<!--
    Elementos globais de tela (relogio, atividade dos controles).
    Cada moldura de console em ./_retrobat/consoles/ sobrescreve as posicoes.
-->
<theme>
  <formatVersion>7</formatVersion>

  <view name="screen">
    <text name="clock">
      <pos>0.0125 0.045</pos>
      <size>0.12 0.05</size>
      <origin>0 0</origin>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${altFont}</fontPath>
      <fontSize>0.0375</fontSize>
      <color>${helpColor}</color>
    </text>
    <!-- O ES-DE Mini nao tem indicador de atividade de controle nem de bateria.
         Sem <imagePath> o ES desenha retangulos piscando no canto inferior
         esquerdo, por cima da barra de ajuda - por isso ficam ocultos.
         Para reativar, troque visible para true e defina um <imagePath>. -->
    <controllerActivity name="controllerActivity">
      <visible>false</visible>
    </controllerActivity>
    <batteryIndicator name="batteryIndicator">
      <visible>false</visible>
    </batteryIndicator>
    <networkIcon name="networkIcon">
      <visible>false</visible>
    </networkIcon>
  </view>
</theme>
